# Copy to /etc/halieus-game-room/halieus.env and adjust paths/secrets locally.
NODE_ENV=production
PORT=3000
SERVE_CLIENT=true
PUBLIC_APP_URL=https://halieus.remotewire.net
CLIENT_ORIGINS=https://halieus.remotewire.net
HALIEUS_DATA_DIR=/var/lib/halieus-game-room
# Optional: HGR_RELEASE_WAKE_SECRET (32+ random characters, same as GitHub Actions secret). Set securely on the server; never commit its value.
